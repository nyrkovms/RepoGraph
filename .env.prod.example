# Production baseline configuration for PackageHub API
# Copy to deployment secret manager / runtime environment.

# Postgres
POSTGRES_DB=packagehub
POSTGRES_USER=packagehub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# API runtime
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=/var/log/packagehub/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=3
APP_ENV=production
API_DOCS_ENABLED=false
CORS_ALLOW_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com
SECURITY_HSTS_ENABLED=true

# Auth (must be rotated and stored as secrets)
API_TOKEN_ADMIN=CHANGE_ME_STRONG_ADMIN_TOKEN

# Sync
DAILY_UPDATE_ENABLED=true
DAILY_UPDATE_HOUR_UTC=3
DAILY_UPDATE_MINUTE_UTC=0
DAILY_UPDATE_CONCURRENCY=4
SYNC_PYPI_JSON_BASE_URL=https://pypi.org/pypi
SYNC_HTTP_TIMEOUT_SECONDS=10
SYNC_HTTP_MAX_RETRIES=3
SYNC_HTTP_RETRY_BASE_SECONDS=0.5
SYNC_HTTP_RETRY_MAX_SECONDS=8
SYNC_HTTP_RETRY_JITTER_SECONDS=0.25
SYNC_FAILED_RETRY_INTERVAL_SECONDS=900
SYNC_FAILED_RETRY_BATCH_LIMIT=100
SYNC_FAILED_RETRY_MAX_ATTEMPTS=8
SYNC_FAILED_RETRY_BACKOFF_SECONDS=30
SYNC_FAILED_RETRY_MAX_BACKOFF_SECONDS=1800
SYNC_FAILED_RETRY_JITTER_SECONDS=3

# Seed
SEED_PACKAGES=flask,django,fastapi,requests,numpy,pandas
