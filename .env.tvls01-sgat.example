# PackageHub deploy env for remote nginx serving:
# - https://tvls01.srv.sf.ru
# - https://sgat.ift.ru
#
# Replace secret placeholders before launch.

# Postgres
POSTGRES_DB=packagehub
POSTGRES_USER=packagehub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# API runtime
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=production
API_DOCS_ENABLED=false
SECURITY_HSTS_ENABLED=true

# Auth
API_TOKEN_VIEWER=CHANGE_ME_STRONG_VIEWER_TOKEN
API_TOKEN_ADMIN=CHANGE_ME_STRONG_ADMIN_TOKEN

# Prebuilt images
BACKEND_IMAGE=repograph-backend:linux-amd64
FRONTEND_IMAGE=repograph-frontend:linux-amd64

# Hosts
# localhost/127.0.0.1 are kept for in-container API health checks.
TRUSTED_HOSTS=127.0.0.1,localhost,tvls01.srv.sf.ru,sgat.ift.ru
CORS_ALLOW_ORIGINS=https://tvls01.srv.sf.ru,https://sgat.ift.ru

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=/var/log/packagehub/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=3

# Sync
SYNC_PYPI_JSON_BASE_URL=https://pypi.org/pypi
SYNC_REFRESH_INTERVAL_HOURS=6
SYNC_REFRESH_BATCH_LIMIT=500
SYNC_HTTP_TIMEOUT_SECONDS=10
SYNC_HTTP_MAX_RETRIES=3
SYNC_HTTP_RETRY_BASE_SECONDS=0.5
SYNC_HTTP_RETRY_MAX_SECONDS=8
SYNC_HTTP_RETRY_JITTER_SECONDS=0.25
SYNC_FAILED_RETRY_INTERVAL_SECONDS=900
SYNC_FAILED_RETRY_BATCH_LIMIT=100
SYNC_FAILED_RETRY_MAX_ATTEMPTS=8
SYNC_FAILED_RETRY_BACKOFF_SECONDS=30
SYNC_FAILED_RETRY_MAX_BACKOFF_SECONDS=1800
SYNC_FAILED_RETRY_JITTER_SECONDS=3

# Seed
SEED_PACKAGES=flask,django,fastapi,requests,numpy,pandas
